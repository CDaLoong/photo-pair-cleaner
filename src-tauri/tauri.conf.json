{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FramePair",
  "version": "0.8.0",
  "identifier": "com.framepair.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FramePair 摄影工作台",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/fonts/NotoSansCJKsc-Regular.otf",
      "resources/fonts/OFL.txt"
    ],
    "category": "Photography",
    "shortDescription": "本地照片浏览、评分、配对清理与水印导出工具",
    "longDescription": "在本机浏览和评分 JPG/RAW 照片组合，安全同步评分与整理配对文件，并使用文字、EXIF、Logo 和装饰边框生成 JPG/PNG 水印副本。"
  }
}
